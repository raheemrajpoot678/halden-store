# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Show the seeded test accounts on /sign-in in production builds too (they are
# always shown in development). Only for demo deployments.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"

# Stripe (hosted Checkout). Use a sandbox/test-mode *restricted* key (rk_test_…);
# never commit real keys. It needs write access to Checkout Sessions and
# Refunds, and read access to PaymentIntents, Charges, Balance, Balance
# transactions and Payouts (admin dashboard). In production store both values
# in your host's secrets manager.
STRIPE_SECRET_KEY=""
# Signing secret for /api/stripe/webhook. Locally, `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints one (whsec_…); in
# production create an endpoint in Workbench → Webhooks subscribed to
# checkout.session.completed, .async_payment_succeeded, .async_payment_failed,
# .expired, refund.created, refund.updated, charge.refunded, charge.succeeded
# and charge.updated.
STRIPE_WEBHOOK_SECRET=""
